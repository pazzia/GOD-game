# Godot import cache and local Python files
.godot/
__pycache__/
*.py[cod]

# Installable packages are distributed through GitHub Releases; the selected
# standalone test APK is also stored in Git LFS for repository downloads.
*.apk
!/artifacts/android/*.apk
*.aab
*.apks
dist/
*.partial

# Local configuration and private signing identities
.env
.env.*
local.properties
*.jks
*.keystore

# Local build outputs; reviewed evidence lives in docs/reviews/.
build/
*.idsig
